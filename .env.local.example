# ============================================================
# GRUAS LUAIDESA — Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local a Git (ya está en .gitignore).
# ============================================================

# --- Supabase (base de datos: leads, baterías, contactos) ---
# Dashboard de Supabase → Project Settings → API
# SUPABASE_URL          = "Project URL"
# SUPABASE_SERVICE_ROLE_KEY = "service_role" (secreto, NUNCA en el frontend)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- Supabase Auth (panel de administración /panel-control) ---
# Mismo proyecto de Supabase. Estas SÍ son públicas por diseño (la
# clave "anon" solo permite login/logout; los datos reales van
# siempre por el backend con la service_role key de arriba).
# Dashboard de Supabase → Project Settings → API
#   NEXT_PUBLIC_SUPABASE_URL      = "Project URL" (la misma URL de arriba)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = "anon public"
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# --- Aviso por email de cada solicitud del formulario (Resend) ---
# Resend (resend.com) tiene un plan gratuito de 3.000 emails/mes.
# RESEND_API_KEY: se genera en resend.com → API Keys
# NOTIFICATION_EMAIL: el Gmail donde quieres recibir cada solicitud
RESEND_API_KEY=re_tu_api_key_aqui
NOTIFICATION_EMAIL=gruasluaidesa@gmail.com
# Opcional: remitente. Por defecto usa el dominio de pruebas de Resend
# (funciona sin verificar nada). Si verificas tu propio dominio en
# Resend, puedes poner algo como "Grúas Luaidesa <avisos@tudominio.com>"
EMAIL_FROM=Grúas Luaidesa <onboarding@resend.dev>

# --- Google Analytics 4 ---
# analytics.google.com > Admin > Data Streams > tu sitio > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Contacto (usado en botones, JSON-LD y páginas legales) ---
# Sin "+" ni espacios para el enlace de WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=34674088195
# Con formato legible para mostrar en pantalla
NEXT_PUBLIC_PHONE_NUMBER=+34 674 08 81 95
NEXT_PUBLIC_EMAIL=gruasluaidesa@gmail.com

# --- URL del sitio en producción (SEO, sitemap, robots, Open Graph) ---
NEXT_PUBLIC_SITE_URL=https://www.luaidesa.com

# --- Redes sociales (opcional, para el SEO — se enlazan como "sameAs") ---
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Verificación de Google Search Console (opcional) ---
# Search Console → Añadir propiedad → método "Etiqueta HTML" → copia
# solo el valor del atributo content="..." (no la etiqueta entera)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

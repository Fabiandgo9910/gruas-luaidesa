# ============================================================
# GRUAS LUAIDESA — Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local a Git (ya está en .gitignore).
# ============================================================

# --- Supabase (base de datos de leads) ---
# Dashboard de Supabase → Project Settings → API
# SUPABASE_URL          = "Project URL"
# SUPABASE_SERVICE_ROLE_KEY = "service_role" (secreto, NUNCA en el frontend)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# --- Google Analytics 4 ---
# analytics.google.com > Admin > Data Streams > tu sitio > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Contacto (usado en botones, JSON-LD y páginas legales) ---
# Sin "+" ni espacios para el enlace de WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=34674088195
# Con formato legible para mostrar en pantalla
NEXT_PUBLIC_PHONE_NUMBER=+34 674 08 81 95
NEXT_PUBLIC_EMAIL=gruasluaidesa@gmail.com

# --- URL del sitio en producción (SEO, sitemap, robots, Open Graph) ---
NEXT_PUBLIC_SITE_URL=https://www.gruasluaidesa.com
